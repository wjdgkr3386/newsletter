@{
    Layout = "_AppLayout";
    ViewData["Title"] = "뉴스레터 설정 관리";

    // 시(00~23), 분(00~59) 선택지 (D-079)
    IEnumerable<string> hourOptions = Enumerable.Range(0, 24).Select(hour => hour.ToString("00"));
    IEnumerable<string> minuteOptions = Enumerable.Range(0, 60).Select(minute => minute.ToString("00"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<div class="settings-area">
    <h1 class="h4 mb-3">뉴스레터 설정 관리</h1>

    <div id="page-alert" class="alert d-none" role="alert"></div>

    <p id="settings-loading" class="text-secondary">불러오는 중...</p>
    <div id="settings-card" class="card d-none">
        <div class="card-body p-4">
            <div class="mb-3">
                <label for="generate-hour" class="form-label">자동 생성 시간</label>
                <div class="d-flex align-items-center gap-2">
                    <select id="generate-hour" class="form-select time-select" aria-label="자동 생성 시">
                        @foreach (string hour in hourOptions)
                        {
                            <option value="@hour">@hour</option>
                        }
                    </select>
                    <span>시</span>
                    <select id="generate-minute" class="form-select time-select" aria-label="자동 생성 분">
                        @foreach (string minute in minuteOptions)
                        {
                            <option value="@minute">@minute</option>
                        }
                    </select>
                    <span>분</span>
                </div>
            </div>

            <div class="mb-3">
                <label for="send-hour" class="form-label">자동 발송 시간</label>
                <div class="d-flex align-items-center gap-2">
                    <select id="send-hour" class="form-select time-select" aria-label="자동 발송 시">
                        @foreach (string hour in hourOptions)
                        {
                            <option value="@hour">@hour</option>
                        }
                    </select>
                    <span>시</span>
                    <select id="send-minute" class="form-select time-select" aria-label="자동 발송 분">
                        @foreach (string minute in minuteOptions)
                        {
                            <option value="@minute">@minute</option>
                        }
                    </select>
                    <span>분</span>
                </div>
                <div id="time-error" class="text-danger small mt-1 d-none">생성 시간은 발송 시간보다 앞서야 합니다.</div>
            </div>

            <p class="small text-secondary mb-4">한국 시간(KST) 기준이며, 평일(주말·공휴일 제외)에만 자동으로 생성·발송합니다.</p>

            <button type="button" id="btn-save" class="btn btn-primary w-100" disabled>저장</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
