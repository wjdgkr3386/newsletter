@{
    Layout = "_AppLayout";
    ViewData["Title"] = "수신자 관리";
}

@section Styles {
    <link rel="stylesheet" href="~/css/recipients.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0 recipients-title">수신자 관리</h1>
    <div>
        <button type="button" id="btn-open-add" class="btn btn-primary">수신자 추가</button>
        <button type="button" id="btn-open-delete" class="btn btn-outline-danger ms-1">수신자 삭제</button>
    </div>
</div>

<div id="page-alert" class="alert d-none" role="alert"></div>

<p id="recipient-count" class="small text-secondary mb-2"></p>
<p id="recipient-loading" class="text-secondary">불러오는 중...</p>
<table id="recipient-table" class="table table-bordered bg-white recipients-table d-none">
    <thead class="table-light">
        <tr>
            <th style="width: 30%">이름</th>
            <th>이메일</th>
        </tr>
    </thead>
    <tbody id="recipient-rows"></tbody>
</table>
<nav id="recipient-paging" class="d-none" aria-label="수신자 목록 페이지"></nav>
<p id="recipient-empty" class="text-secondary d-none">등록된 수신자가 없습니다.</p>

@* 추가/삭제 팝업 (같은 모양, recipients.js가 제목과 목록을 바꿔 쓴다) *@
<div class="modal fade" id="picker-modal" tabindex="-1" aria-labelledby="picker-title" aria-hidden="true">
    <div class="modal-dialog picker-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="picker-title" class="modal-title fs-5"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <div id="picker-error" class="alert alert-danger d-none" role="alert"></div>
                <input type="text" id="picker-search" class="form-control mb-3" placeholder="이름 또는 이메일 검색" maxlength="50" />
                <p id="picker-loading" class="text-secondary mb-0 d-none">불러오는 중...</p>
                <table id="picker-table" class="table table-bordered picker-table mb-0 d-none">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 44px"><input type="checkbox" id="picker-check-all" class="form-check-input" aria-label="전체 선택" /></th>
                            <th style="width: 30%">이름</th>
                            <th>이메일</th>
                        </tr>
                    </thead>
                    <tbody id="picker-rows"></tbody>
                </table>
                <p id="picker-empty" class="text-secondary mb-0 d-none"></p>
                <nav id="picker-paging" class="mt-3 d-none" aria-label="팝업 목록 페이지"></nav>
            </div>
            <div class="modal-footer justify-content-between">
                <span id="picker-selected" class="small text-secondary">0명 선택</span>
                <div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                    <button type="button" id="picker-submit" class="btn btn-primary ms-1" disabled></button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recipients.js" asp-append-version="true"></script>
}
